# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database (Supabase PostgreSQL)
# Prisma CLI reads root `.env` (copy these two vars there). Next.js uses .env.local / .env.development.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Production (Vercel + www.getbusal.com)
# NEXT_PUBLIC_APP_URL=https://www.getbusal.com
# Supabase Auth Site URL: https://www.getbusal.com
# Redirect URLs: https://www.getbusal.com/auth/callback
# DNS: CNAME www → cname.vercel-dns.com

# Supabase Auth setup (Dashboard > Authentication)
# 1. Enable Email provider (email + password)
# 2. Enable Google provider and add OAuth client ID/secret from Google Cloud Console
# 3. Add redirect URLs (Authentication > URL Configuration):
#    - Site URL: http://localhost:3000
#    - Redirect URLs:
#      - http://localhost:3000/auth/callback
#      - http://localhost:3000/auth/callback?next=/reset-password
# 4. For production, repeat with your production domain
