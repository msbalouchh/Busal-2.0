  @@unique([branchId, tableNumber])
  @@index([businessId, branchId, status])
  @@index([floorId, status])
  @@map("restaurant_tables")
}

model Reservation {
  id                String            @id @default(uuid())
  businessId        String            @map("business_id")
  branchId          String            @map("branch_id")
  legacyTableId     String?           @map("table_id")
  restaurantTableId String?           @map("restaurant_table_id")
  customerId        String?           @map("customer_id")
  assignedStaffId   String?           @map("assigned_staff_id")
  createdByStaffId  String?           @map("created_by_staff_id")
  reservationNumber String            @unique @map("reservation_number")
  guestName         String            @map("guest_name")
  guestPhone        String            @map("guest_phone")
  guestEmail        String?           @map("guest_email")
  partySize         Int               @map("party_size")
  reservationDate   DateTime          @map("reservation_date") @db.Date
  startTime         String            @map("start_time")
  endTime           String            @map("end_time")
  status            ReservationStatus @default(PENDING)
  source            ReservationSource @default(PHONE)
  specialRequests   String?           @map("special_requests")
  notes             String?
  checkInTime       DateTime?         @map("check_in_time")
  checkOutTime      DateTime?         @map("check_out_time")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  assignedStaff     Staff?            @relation("ReservationAssignedStaff", fields: [assignedStaffId], references: [id])
  branch            Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByStaff    Staff?            @relation("ReservationCreatedBy", fields: [createdByStaffId], references: [id])
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  legacyTable       LegacyTable?      @relation(fields: [legacyTableId], references: [id])
  restaurantTable   RestaurantTable?  @relation(fields: [restaurantTableId], references: [id], onDelete: SetNull)
  restaurantOrders  RestaurantOrder[]

  @@index([businessId, branchId, reservationDate, status])
  @@index([branchId, reservationDate, restaurantTableId])
  @@index([businessId, guestPhone])
  @@map("reservations")
}

model QRCode {
