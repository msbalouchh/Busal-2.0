model QRMenuSession {
  id            String         @id @default(uuid())
  qrCodeId      String         @map("qr_code_id")
  tableId       String?        @map("table_id")
  businessId    String         @map("business_id")
  sessionToken  String         @unique @map("session_token")
  startedAt     DateTime       @default(now()) @map("started_at")
  endedAt       DateTime?      @map("ended_at")
  deviceInfo    String?        @map("device_info")
  ipAddress     String?        @map("ip_address")
  branchId      String?        @map("branch_id")
  carts         Cart[]
  orderSessions OrderSession[]
  branch        Branch?        @relation(fields: [branchId], references: [id])
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  qrCode        QRCode         @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  table         LegacyTable?         @relation(fields: [tableId], references: [id])

  @@map("qr_menu_sessions")
}

model OrderSession {
  id              String             @id @default(uuid())
  businessId      String             @map("business_id")
  cartId          String             @map("cart_id")
  qrMenuSessionId String             @map("qr_menu_session_id")
  sessionType     OrderSessionType   @default(DINE_IN) @map("session_type")
  tableId         String?            @map("table_id")
  customerName    String?            @map("customer_name")
  customerPhone   String?            @map("customer_phone")
  orderNotes      String?            @map("order_notes")
  status          OrderSessionStatus @default(ACTIVE)
  expiresAt       DateTime           @map("expires_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  branchId        String?            @map("branch_id")
  branch          Branch?            @relation(fields: [branchId], references: [id])
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cart            Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  qrMenuSession   QRMenuSession      @relation(fields: [qrMenuSessionId], references: [id], onDelete: Cascade)
  table           LegacyTable?             @relation(fields: [tableId], references: [id])
  order           LegacyOrder?

  @@map("order_sessions")
}

model Cart {
  id              String         @id @default(uuid())
  businessId      String         @map("business_id")
  qrMenuSessionId String         @map("qr_menu_session_id")
  status          CartStatus     @default(ACTIVE)
  subtotal        Decimal        @default(0) @db.Decimal(10, 2)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  branchId        String?        @map("branch_id")
  items           CartItem[]
  branch          Branch?        @relation(fields: [branchId], references: [id])
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  qrMenuSession   QRMenuSession  @relation(fields: [qrMenuSessionId], references: [id], onDelete: Cascade)
  orderSessions   OrderSession[]

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String   @map("cart_id")
  menuItemId String   @map("menu_item_id")
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([cartId, menuItemId])
  @@map("cart_items")
}

model LegacyOrder {
  id             String               @id @default(uuid())
  businessId     String               @map("business_id")
  orderSessionId String               @unique @map("order_session_id")
  orderNumber    String               @map("order_number")
  fulfilmentType FulfilmentType       @map("fulfilment_type")
  tableId        String?              @map("table_id")
  customerName   String?              @map("customer_name")
  customerPhone  String?              @map("customer_phone")
  notes          String?
  subtotal       Decimal              @db.Decimal(10, 2)
  discount       Decimal              @default(0) @db.Decimal(10, 2)
  tax            Decimal              @default(0) @db.Decimal(10, 2)
  total          Decimal              @db.Decimal(10, 2)
  status         OrderStatus          @default(PENDING)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  customerId     String?              @map("customer_id")
  branchId       String?              @map("branch_id")
  kitchenQueue   KitchenQueue?
  items          LegacyOrderItem[]
  stockDeduction OrderStockDeduction?
  branch         Branch?              @relation(fields: [branchId], references: [id])
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?            @relation(fields: [customerId], references: [id])
  orderSession   OrderSession         @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)
  table          LegacyTable?         @relation(fields: [tableId], references: [id])
  payments       Payment[]
  receipts       Receipt[]
  stockMovements StockMovement[]

  @@unique([businessId, orderNumber])
  @@map("orders")
}

model LegacyOrderItem {
  id           String      @id @default(uuid())
  orderId      String      @map("order_id")
  menuItemId   String      @map("menu_item_id")
  nameSnapshot String      @map("name_snapshot")
  unitPrice    Decimal     @map("unit_price") @db.Decimal(10, 2)
  quantity     Int
  totalPrice   Decimal     @map("total_price") @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  menuItem     MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  order        LegacyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model RestaurantOrder {
  id              String                      @id @default(uuid())
  businessId      String                      @map("business_id")
  branchId        String                      @map("branch_id")
  orderNumber     String                      @map("order_number")
  orderType       OrderType                   @map("order_type")
  customerId      String?                     @map("customer_id")
  restaurantTableId String?                   @map("restaurant_table_id")
  reservationId   String?                     @map("reservation_id")
  qrSessionId     String?                     @map("qr_session_id")
  staffId         String?                     @map("staff_id")
  status          RestaurantOrderStatus       @default(PENDING)
  subtotal        Decimal                     @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal                     @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount       Decimal                     @default(0) @map("tax_amount") @db.Decimal(10, 2)
  serviceCharge   Decimal                     @default(0) @map("service_charge") @db.Decimal(10, 2)
  deliveryCharge  Decimal                     @default(0) @map("delivery_charge") @db.Decimal(10, 2)
  tipAmount       Decimal                     @default(0) @map("tip_amount") @db.Decimal(10, 2)
  totalAmount     Decimal                     @default(0) @map("total_amount") @db.Decimal(10, 2)
  paymentStatus   RestaurantOrderPaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod   PaymentMethod?              @map("payment_method")
  notes           String?
  isPriority      Boolean                     @default(false) @map("is_priority")
  kitchenAcceptedAt DateTime?                 @map("kitchen_accepted_at")
  kitchenPreparingAt DateTime?                @map("kitchen_preparing_at")
  kitchenReadyAt  DateTime?                   @map("kitchen_ready_at")
  kitchenServedAt DateTime?                   @map("kitchen_served_at")
  placedAt        DateTime                    @default(now()) @map("placed_at")
  completedAt     DateTime?                   @map("completed_at")
  cancelledAt     DateTime?                   @map("cancelled_at")
  mergedFromOrderId String?                   @map("merged_from_order_id")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  branch          Branch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business        Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  mergedFrom      RestaurantOrder?            @relation("RestaurantOrderMerge", fields: [mergedFromOrderId], references: [id], onDelete: SetNull)
  mergedSources   RestaurantOrder[]           @relation("RestaurantOrderMerge")
  reservation     Reservation?                @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  qrSession       QRSession?                  @relation(fields: [qrSessionId], references: [id], onDelete: SetNull)
  restaurantTable RestaurantTable?            @relation(fields: [restaurantTableId], references: [id], onDelete: SetNull)
  staff           Staff?                      @relation("RestaurantOrderStaff", fields: [staffId], references: [id], onDelete: SetNull)
  items           RestaurantOrderItem[]
  payments        OrderPayment[]

  @@unique([businessId, orderNumber])
  @@index([businessId, branchId, status])
  @@index([branchId, placedAt])
  @@index([businessId, paymentStatus])
  @@index([qrSessionId])
  @@map("restaurant_orders")
}

model TableQRCode {
  id              String        @id @default(uuid())
  businessId      String        @map("business_id")
  branchId        String        @map("branch_id")
  tableId         String        @map("table_id")
  token           String        @unique
  qrCodeUrl       String        @map("qr_code_url")
  status          QRCodeStatus  @default(ACTIVE)
  lastGeneratedAt DateTime      @default(now()) @map("last_generated_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table           RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId])
  @@index([businessId, branchId, status])
  @@map("table_qr_codes")
}

model QRSession {
  id               String          @id @default(uuid())
  businessId       String          @map("business_id")
  branchId         String          @map("branch_id")
  tableId          String          @map("table_id")
  token            String          @unique
  customerName     String?         @map("customer_name")
  customerPhone    String?         @map("customer_phone")
  sessionStatus    QRSessionStatus @default(ACTIVE) @map("session_status")
  waiterRequestedAt DateTime?      @map("waiter_requested_at")
  billRequestedAt  DateTime?       @map("bill_requested_at")
  lastActivityAt   DateTime        @default(now()) @map("last_activity_at")
  expiresAt        DateTime        @map("expires_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  branch           Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table            RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders           RestaurantOrder[]

  @@index([businessId, branchId, sessionStatus])
  @@index([expiresAt])
  @@map("qr_sessions")
}

model OrderPayment {
  id                   String                 @id @default(uuid())
  businessId           String                 @map("business_id")
  branchId             String                 @map("branch_id")
  orderId              String                 @map("order_id")
  paymentNumber        String                 @map("payment_number")
  paymentMethod        OrderPaymentMethod     @map("payment_method")
  paymentProvider      String?                @map("payment_provider")
  status               OrderPaymentStatus     @default(PENDING)
  subtotal             Decimal                @db.Decimal(10, 2)
  discountAmount       Decimal                @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount            Decimal                @default(0) @map("tax_amount") @db.Decimal(10, 2)
  serviceCharge        Decimal                @default(0) @map("service_charge") @db.Decimal(10, 2)
  tipAmount            Decimal                @default(0) @map("tip_amount") @db.Decimal(10, 2)
  amountPaid           Decimal                @map("amount_paid") @db.Decimal(10, 2)
  changeGiven          Decimal                @default(0) @map("change_given") @db.Decimal(10, 2)
  currency             String                 @default("GBP")
  exchangeRate         Decimal?               @map("exchange_rate") @db.Decimal(12, 6)
  transactionReference String?                @map("transaction_reference")
  gatewayReference     String?                @map("gateway_reference")
  processedByStaffId   String?                @map("processed_by_staff_id")
  paidAt               DateTime?              @map("paid_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  branch               Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business             Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order                RestaurantOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  processedBy          Staff?                 @relation("OrderPaymentProcessor", fields: [processedByStaffId], references: [id], onDelete: SetNull)
  transactions         OrderPaymentTransaction[]
  receipt              OrderReceipt?

  @@unique([businessId, paymentNumber])
  @@index([businessId, branchId, status])
  @@index([orderId, status])
  @@index([transactionReference])
  @@map("order_payments")
}

model OrderPaymentTransaction {
  id               String                    @id @default(uuid())
  paymentId        String                    @map("payment_id")
  transactionType  PaymentTransactionType    @map("transaction_type")
  amount           Decimal                   @db.Decimal(10, 2)
  status           OrderPaymentStatus        @default(PENDING)
  reference        String?
  providerResponse Json?                     @map("provider_response")
  processedAt      DateTime?                 @map("processed_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  payment          OrderPayment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, transactionType])
  @@map("order_payment_transactions")
}

model OrderReceiptSequence {
  businessId String   @id @map("business_id")
  lastNumber Int      @default(0) @map("last_number")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("order_receipt_sequences")
}

model OrderReceipt {
  id            String       @id @default(uuid())
  businessId    String       @map("business_id")
  paymentId     String       @unique @map("payment_id")
  receiptNumber String       @map("receipt_number")
  receiptUrl    String?      @map("receipt_url")
  printedCount  Int          @default(0) @map("printed_count")
  emailedAt     DateTime?    @map("emailed_at")
  smsSentAt     DateTime?    @map("sms_sent_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment       OrderPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([businessId, receiptNumber])
  @@map("order_receipts")
}

model RestaurantOrderItem {
  id                  String                    @id @default(uuid())
  orderId             String                    @map("order_id")
  productId           String                    @map("product_id")
  productNameSnapshot String                    @map("product_name_snapshot")
  quantity            Int
  unitPrice           Decimal                   @map("unit_price") @db.Decimal(10, 2)
  discountAmount      Decimal                   @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount           Decimal                   @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount         Decimal                   @map("total_amount") @db.Decimal(10, 2)
  specialInstructions String?                   @map("special_instructions")
  status              RestaurantOrderItemStatus @default(PENDING)
  preparingStartedAt  DateTime?                 @map("preparing_started_at")
  readyAt             DateTime?                 @map("ready_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  order               RestaurantOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers           RestaurantOrderItemModifier[]

  @@index([orderId, status])
  @@map("restaurant_order_items")
}

model RestaurantOrderItemModifier {
  id              String                @id @default(uuid())
  orderItemId     String                @map("order_item_id")
  modifierOptionId String               @map("modifier_option_id")
  nameSnapshot    String                @map("name_snapshot")
  priceAdjustment Decimal               @default(0) @map("price_adjustment") @db.Decimal(10, 2)
  createdAt       DateTime              @default(now()) @map("created_at")
  modifierOption  ModifierOption        @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)
  orderItem       RestaurantOrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("restaurant_order_item_modifiers")
}

model KitchenStation {
  id           String               @id @default(uuid())
  businessId   String               @map("business_id")
  branchId     String               @map("branch_id")
  name         String
  description  String?
  displayOrder Int                  @default(0) @map("display_order")
  status       KitchenStationStatus @default(ACTIVE)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products     KitchenStationProduct[]

  @@unique([branchId, name])
  @@index([businessId, branchId, status])
  @@index([branchId, displayOrder])
  @@map("kitchen_stations")
}

model KitchenStationProduct {
  id        String         @id @default(uuid())
  stationId String         @map("station_id")
  productId String         @map("product_id")
  createdAt DateTime       @default(now()) @map("created_at")
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  station   KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, productId])
  @@index([productId])
  @@map("kitchen_station_products")
}

model KitchenQueue {
  id             String               @id @default(uuid())
  businessId     String               @map("business_id")
  orderId        String               @unique @map("order_id")
  priority       KitchenQueuePriority @default(NORMAL)
  station        KitchenQueueStation  @default(GENERAL)
  status         KitchenQueueStatus   @default(NEW)
  queuedAt       DateTime             @default(now()) @map("queued_at")
  acknowledgedAt DateTime?            @map("acknowledged_at")
  preparingAt    DateTime?            @map("preparing_at")
  readyAt        DateTime?            @map("ready_at")
  servedAt       DateTime?            @map("served_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  branchId       String?              @map("branch_id")
  branch         Branch?              @relation(fields: [branchId], references: [id])
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order          LegacyOrder                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("kitchen_queue")
}

model Payment {
  id             String        @id @default(uuid())
  businessId     String        @map("business_id")
  orderId        String        @map("order_id")
  staffId        String?       @map("staff_id")
  method         PaymentMethod
  amount         Int
  amountTendered Int?          @map("amount_tendered")
  status         PaymentStatus @default(COMPLETED)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  branchId       String?       @map("branch_id")
  branch         Branch?       @relation(fields: [branchId], references: [id])
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order          LegacyOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff          Staff?        @relation(fields: [staffId], references: [id])
  receipt        Receipt?

  @@map("payments")
}

model ReceiptSequence {
  businessId String   @id @map("business_id")
  lastNumber Int      @default(0) @map("last_number")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("receipt_sequences")
}

model Receipt {
  id                  String              @id @default(uuid())
  businessId          String              @map("business_id")
  orderId             String              @map("order_id")
  paymentId           String              @unique @map("payment_id")
  receiptNumber       String              @map("receipt_number")
  createdByStaffId    String?             @map("created_by_staff_id")
  businessName        String              @map("business_name")
  businessAddress     String?             @map("business_address")
  businessPhone       String?             @map("business_phone")
  businessEmail       String?             @map("business_email")
  customerName        String?             @map("customer_name")
  customerPhone       String?             @map("customer_phone")
  orderNumber         String              @map("order_number")
  tableName           String?             @map("table_name")
  staffName           String?             @map("staff_name")
  paymentMethod       PaymentMethod       @map("payment_method")
  currency            String              @default("GBP")
  locale              String              @default("en-GB")
  subtotalPence       Int                 @map("subtotal_pence")
  discountPence       Int                 @default(0) @map("discount_pence")
  taxPence            Int                 @default(0) @map("tax_pence")
  totalPence          Int                 @map("total_pence")
  paymentAmountPence  Int                 @map("payment_amount_pence")
  amountTenderedPence Int?                @map("amount_tendered_pence")
  changeDuePence      Int                 @default(0) @map("change_due_pence")
  printCount          Int                 @default(0) @map("print_count")
  lastPrintStatus     ReceiptPrintStatus? @map("last_print_status")
  lastPrintedAt       DateTime?           @map("last_printed_at")
  deliveryEmail       String?             @map("delivery_email")
  deliveryPhone       String?             @map("delivery_phone")
  qrCodeData          String?             @map("qr_code_data")
  createdAt           DateTime            @default(now()) @map("created_at")
  branchId            String?             @map("branch_id")
  auditLogs           ReceiptAuditLog[]
  items               ReceiptItem[]
  printLogs           ReceiptPrintLog[]
  branch              Branch?             @relation(fields: [branchId], references: [id])
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByStaff      Staff?              @relation(fields: [createdByStaffId], references: [id])
  order               LegacyOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment             Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([businessId, receiptNumber])
  @@map("receipts")
}

model ReceiptItem {
  id             String  @id @default(uuid())
  receiptId      String  @map("receipt_id")
  name           String
  quantity       Int
  unitPricePence Int     @map("unit_price_pence")
  lineTotalPence Int     @map("line_total_pence")
  discountPence  Int     @default(0) @map("discount_pence")
  taxRateBps     Int?    @map("tax_rate_bps")
  receipt        Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("receipt_items")
}

model ReceiptPrintLog {
  id           String              @id @default(uuid())
  receiptId    String              @map("receipt_id")
  businessId   String              @map("business_id")
  staffId      String?             @map("staff_id")
  templateType ReceiptTemplateType @map("template_type")
  paperSize    ReceiptPaperSize    @map("paper_size")
  status       ReceiptPrintStatus
  isReprint    Boolean             @default(false) @map("is_reprint")
  createdAt    DateTime            @default(now()) @map("created_at")
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  receipt      Receipt             @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  staff        Staff?              @relation(fields: [staffId], references: [id])

  @@map("receipt_print_logs")
}

model ReceiptAuditLog {
  id         String             @id @default(uuid())
  receiptId  String             @map("receipt_id")
  businessId String             @map("business_id")
  staffId    String?            @map("staff_id")
  action     ReceiptAuditAction
  metadata   Json?
  createdAt  DateTime           @default(now()) @map("created_at")
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  receipt    Receipt            @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  staff      Staff?             @relation(fields: [staffId], references: [id])

  @@map("receipt_audit_logs")
}

model IngredientCategory {
  id          String       @id @default(uuid())
  businessId  String       @map("business_id")
  name        String
  slug        String
  sortOrder   Int          @default(0) @map("sort_order")
  isSystem    Boolean      @default(false) @map("is_system")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]

  @@unique([businessId, slug])
  @@map("ingredient_categories")
}

model Ingredient {
