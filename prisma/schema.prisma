model SalesOpportunity {
  id                String    @id @default(uuid())
  businessId        String    @map("business_id")
  pipelineId        String    @map("pipeline_id")
  stageId           String    @map("stage_id")
  companyId         String?   @map("company_id")
  contactId         String?   @map("contact_id")
  assignedStaffId   String?   @map("assigned_staff_id")
  name              String
  description       String?
  valuePence        Int       @default(0) @map("value_pence")
  currency          String    @default("GBP")
  expectedCloseDate DateTime? @map("expected_close_date")
  preparedQuoteId     String? @unique @map("prepared_quote_id")
  preparedProposalId  String? @unique @map("prepared_proposal_id")
  preparedContractId  String? @unique @map("prepared_contract_id")
  preparedInvoiceId   String? @map("prepared_invoice_id")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  business        Business                         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pipeline        SalesPipeline                    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage           SalesPipelineStage               @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company         SalesCompany?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact         SalesContact?                    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedStaff   Staff?                           @relation("SalesOpportunityAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  convertedLead   SalesLead?                       @relation("LeadConversion")
  catalogueLinks  SalesOpportunityCatalogueLink[]
  activities      SalesActivity[]
  tasks           SalesTask[]
  demos           SalesDemo[]
  quotes          Quote[]
