  versions         CommercialProductVersion[] @relation("ProductVersions")

  @@unique([businessId, sku])
  @@index([businessId, status])
  @@map("commercial_products")
}

model CommercialProductVersion {
  id                       String                  @id @default(uuid())
  productId                String                  @map("product_id")
  versionNumber            Int                     @map("version_number")
  name                     String
  description              String?
  pricingModel             CommercialPricingModel  @map("pricing_model")
  basePricePence           Int                     @map("base_price_pence")
  currency                 String                  @default("GBP")
  taxClass                 String?                 @map("tax_class")
  industry                 String?
  setupRequired            Boolean                 @default(false) @map("setup_required")
  requiresContract         Boolean                 @default(false) @map("requires_contract")
  renewable                Boolean                 @default(false)
  defaultBillingCycle      CommercialBillingCycle? @map("default_billing_cycle")
