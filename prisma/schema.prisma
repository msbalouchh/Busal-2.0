  verifiedAt      DateTime?         @map("verified_at")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  business Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  policy   BackupPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  jobs     RecoveryJob[]

  @@index([businessId, scope, createdAt])
  @@index([businessId, status])
  @@map("backup_records")
}

model BackupRetentionPolicy {
  id            String   @id @default(cuid())
  businessId    String?  @map("business_id")
  name          String
  retentionDays Int      @default(30) @map("retention_days")
  archiveEnabled Boolean @default(false) @map("archive_enabled")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@map("backup_retention_policies")
}

model DisasterRecoveryPlan {
  id          String   @id @default(cuid())
  businessId  String?  @map("business_id")
  name        String
  description String   @default("") @db.Text
  rtoMinutes  Int      @default(60) @map("rto_minutes")
  rpoMinutes  Int      @default(15) @map("rpo_minutes")
  steps       Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@map("disaster_recovery_plans")
}

model RecoveryJob {
  id            String            @id @default(cuid())
  businessId    String?           @map("business_id")
  backupId      String?           @map("backup_id")
  userId        String?           @map("user_id")
  jobType       RecoveryJobType   @map("job_type")
  status        RecoveryJobStatus @default(PENDING)
  progressPct   Int               @default(0) @map("progress_pct")
  branchId      String?           @map("branch_id")
  pitrTimestamp DateTime?         @map("pitr_timestamp")
  previewData   Json?             @map("preview_data")
  errorMessage  String?           @map("error_message") @db.Text
  startedAt     DateTime?         @map("started_at")
  completedAt   DateTime?         @map("completed_at")
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  business Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  backup   BackupRecord? @relation(fields: [backupId], references: [id], onDelete: SetNull)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, status, createdAt])
  @@map("recovery_jobs")
}

model BackupPlatformAuditLog {
  id         String               @id @default(cuid())
  businessId String?              @map("business_id")
  userId     String?              @map("user_id")
  eventType  BackupAuditEventType @map("event_type")
  metadata   Json?
  createdAt  DateTime             @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, eventType, createdAt])
  @@map("backup_platform_audit_logs")
}

// ─── Multi-language & Localization Platform ───

enum LocalizationTextDirection {
  LTR
  RTL
}

enum LocalizationScopeType {
  USER
  BUSINESS
  BRANCH
}

enum LocalizationAuditEventType {
  TRANSLATION_CREATED
  TRANSLATION_UPDATED
  VERSION_PUBLISHED
  LANGUAGE_REGISTERED
  PREFERENCE_UPDATED
  PACK_LOADED
  DASHBOARD_ACCESS
  KEY_REGISTERED
}

model LocalizationLanguage {
  id         String                    @id @default(cuid())
  code       String                    @unique
  name       String
  nativeName String                    @map("native_name")
  direction  LocalizationTextDirection @default(LTR)
  isActive   Boolean                   @default(true) @map("is_active")
  isFallback Boolean                   @default(false) @map("is_fallback")
  createdAt  DateTime                  @default(now()) @map("created_at")
  updatedAt  DateTime                  @updatedAt @map("updated_at")

  translations LocalizationTranslation[]

  @@map("localization_languages")
}

model LocalizationTranslationKey {
  id           String   @id @default(cuid())
  businessId   String?  @map("business_id")
  key          String
  module       String
  description  String   @default("") @db.Text
  defaultValue String   @map("default_value") @db.Text
  currentVersion Int  @default(1) @map("current_version")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business     Business?                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  translations LocalizationTranslation[]
  versions     LocalizationTranslationVersion[]

  @@unique([businessId, key])
  @@index([module])
  @@map("localization_translation_keys")
}

model LocalizationTranslation {
  id           String   @id @default(cuid())
  businessId   String?  @map("business_id")
  keyId        String   @map("key_id")
  languageCode String   @map("language_code")
  value        String   @db.Text
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business Business?                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key      LocalizationTranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  language LocalizationLanguage     @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([businessId, keyId, languageCode])
  @@index([languageCode])
  @@map("localization_translations")
}

model LocalizationTranslationVersion {
  id           String   @id @default(cuid())
  businessId   String?  @map("business_id")
  keyId        String   @map("key_id")
  languageCode String   @map("language_code")
  version      Int
  value        String   @db.Text
  changeReason String?  @map("change_reason") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  business Business?                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key      LocalizationTranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([keyId, languageCode, version])
  @@map("localization_translation_versions")
}

model LocalizationScopeSetting {
  id                   String                @id @default(cuid())
  businessId           String?               @map("business_id")
  scopeType            LocalizationScopeType @map("scope_type")
  scopeIdentifier      String                @map("scope_identifier")
  languageCode         String                @map("language_code")
  fallbackLanguageCode String                @default("en") @map("fallback_language_code")
  timezone             String                @default("UTC")
  dateFormat           String                @default("yyyy-MM-dd") @map("date_format")
  timeFormat           String                @default("HH:mm") @map("time_format")
  numberFormat         String                @default("en-US") @map("number_format")
  currencyCode         String                @default("USD") @map("currency_code")
  countryCode          String                @default("US") @map("country_code")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, scopeType, scopeIdentifier])
  @@map("localization_scope_settings")
}

model LocalizationPlatformAuditLog {
  id         String                   @id @default(cuid())
  businessId String?                  @map("business_id")
  userId     String?                  @map("user_id")
  eventType  LocalizationAuditEventType @map("event_type")
  metadata   Json?
  createdAt  DateTime                 @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, eventType, createdAt])
  @@map("localization_platform_audit_logs")
}

// ─── Data Import & Export Platform ───

enum ImportExportFormat {
  CSV
  EXCEL
  JSON
  PDF
}

enum ImportExportJobType {
  IMPORT
  EXPORT
}

enum ImportExportJobStatus {
  PENDING
  PREVIEW
  VALIDATING
  PROCESSING
  COMPLETED
  FAILED
  ROLLED_BACK
  CANCELLED
}

enum ImportExportScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ImportExportAuditEventType {
  SCHEMA_REGISTERED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  IMPORT_STARTED
  IMPORT_PREVIEW
  IMPORT_VALIDATED
  IMPORT_COMPLETED
  IMPORT_FAILED
  IMPORT_ROLLED_BACK
  EXPORT_STARTED
  EXPORT_COMPLETED
  EXPORT_FAILED
  SCHEDULE_CREATED
  SCHEDULE_TRIGGERED
  DUPLICATE_DETECTED
  BATCH_PROCESSED
  DASHBOARD_ACCESS
  API_IMPORT
  API_EXPORT
  NOTIFICATION_SENT
}

model ImportExportSchema {
  id            String   @id @default(cuid())
  businessId    String?  @map("business_id")
  schemaKey     String   @map("schema_key")
  module        String
  name          String
  fields        Json
  importFormats Json     @map("import_formats")
  exportFormats Json     @map("export_formats")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business  Business?              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  templates ImportExportTemplate[]
  jobs      ImportExportJob[]
  schedules ImportExportSchedule[]

  @@unique([businessId, schemaKey])
  @@index([module])
  @@map("import_export_schemas")
}

model ImportExportTemplate {
  id            String             @id @default(cuid())
  businessId    String?            @map("business_id")
  schemaId      String             @map("schema_id")
  name          String
  format        ImportExportFormat
  fieldMappings Json               @map("field_mappings")
  isDefault     Boolean            @default(false) @map("is_default")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  business Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  schema   ImportExportSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@index([businessId, schemaId])
  @@map("import_export_templates")
}

model ImportExportSchedule {
  id             String                        @id @default(cuid())
  businessId     String?                       @map("business_id")
  schemaId       String?                       @map("schema_id")
  name           String
  jobType        ImportExportJobType           @map("job_type")
  format         ImportExportFormat
  module         String
  frequency      ImportExportScheduleFrequency
  cronExpression String                        @map("cron_expression")
  fieldMappings  Json?                         @map("field_mappings")
  isActive       Boolean                       @default(true) @map("is_active")
  lastRunAt      DateTime?                     @map("last_run_at")
  nextRunAt      DateTime?                     @map("next_run_at")
  createdAt      DateTime                      @default(now()) @map("created_at")
  updatedAt      DateTime                      @updatedAt @map("updated_at")

  business Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  schema   ImportExportSchema? @relation(fields: [schemaId], references: [id], onDelete: SetNull)
  jobs     ImportExportJob[]

  @@index([businessId, isActive, nextRunAt])
  @@map("import_export_schedules")
}

model ImportExportJob {
  id               String                @id @default(cuid())
  businessId       String?               @map("business_id")
  schemaId         String?               @map("schema_id")
  userId           String?               @map("user_id")
  scheduleId       String?               @map("schedule_id")
  jobType          ImportExportJobType   @map("job_type")
  format           ImportExportFormat
  status           ImportExportJobStatus @default(PENDING)
  module           String
  fileName         String?               @map("file_name")
  source           String                @default("DASHBOARD")
  progressPct      Int                   @default(0) @map("progress_pct")
  totalRecords     Int                   @default(0) @map("total_records")
  successCount     Int                   @default(0) @map("success_count")
  failureCount     Int                   @default(0) @map("failure_count")
  duplicateCount   Int                   @default(0) @map("duplicate_count")
  previewData      Json?                 @map("preview_data")
  validationErrors Json?                 @map("validation_errors")
  fieldMappings    Json?                 @map("field_mappings")
  outputPayload    Json?                 @map("output_payload")
  errorMessage     String?               @map("error_message") @db.Text
  startedAt        DateTime?             @map("started_at")
  completedAt      DateTime?             @map("completed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  business Business?               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  schema   ImportExportSchema?     @relation(fields: [schemaId], references: [id], onDelete: SetNull)
  user     User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedule ImportExportSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  records  ImportExportJobRecord[]

  @@index([businessId, jobType, status, createdAt])
  @@map("import_export_jobs")
}

model ImportExportJobRecord {
  id           String   @id @default(cuid())
  businessId   String?  @map("business_id")
  jobId        String   @map("job_id")
  rowIndex     Int      @map("row_index")
  status       String   @default("PENDING")
  inputData    Json     @map("input_data")
  outputData   Json?    @map("output_data")
  errorMessage String?  @map("error_message") @db.Text
  isDuplicate  Boolean  @default(false) @map("is_duplicate")
  createdAt    DateTime @default(now()) @map("created_at")

  business Business?       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job      ImportExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, rowIndex])
  @@map("import_export_job_records")
}

model ImportExportPlatformAuditLog {
  id         String                     @id @default(cuid())
  businessId String?                    @map("business_id")
  userId     String?                    @map("user_id")
  eventType  ImportExportAuditEventType @map("event_type")
  metadata   Json?
  createdAt  DateTime                   @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, eventType, createdAt])
  @@map("import_export_platform_audit_logs")
}

// ─── Tenant Administration Platform ───

enum TenantLifecycleStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum TenantMaintenanceMode {
  NONE
  READ_ONLY
  FULL_LOCK
  SCHEDULED
}

enum TenantHealthStatus {
  HEALTHY
  DEGRADED
  CRITICAL
}

enum TenantAuditEventType {
  TENANT_CREATED
  TENANT_ACTIVATED
  TENANT_SUSPENDED
  TENANT_REACTIVATED
  TENANT_ARCHIVED
  TENANT_DELETED
  PROFILE_UPDATED
  BRANCH_UPDATED
  SUBSCRIPTION_ASSIGNED
  FEATURE_ASSIGNED
  LIMIT_UPDATED
  RESOURCE_UPDATED
  SETTINGS_UPDATED
  MAINTENANCE_ENABLED
  MAINTENANCE_DISABLED
  MAINTENANCE_UPDATED
  IMPERSONATION_STARTED
  IMPERSONATION_ENDED
  POLICY_UPDATED
  HEALTH_CHECK
  ACTIVITY_RECORDED
  DASHBOARD_ACCESS
  NOTIFICATION_SENT
}

model TenantRecord {
  id                 String                @id @default(cuid())
  businessId         String                @unique @map("business_id")
  lifecycleStatus    TenantLifecycleStatus @default(ACTIVE) @map("lifecycle_status")
  healthStatus       TenantHealthStatus    @default(HEALTHY) @map("health_status")
  subscriptionPlan       String?               @map("subscription_plan")
  subscriptionStatus     String                @default("ACTIVE") @map("subscription_status")
  maintenanceMode        TenantMaintenanceMode @default(NONE) @map("maintenance_mode")
  scheduledMaintenanceAt DateTime?             @map("scheduled_maintenance_at")
  assignedFeatures       Json                  @default("[]") @map("assigned_features")
  branchCount        Int                   @default(0) @map("branch_count")
  archivedAt         DateTime?             @map("archived_at")
  suspendedAt        DateTime?             @map("suspended_at")
  deletedAt          DateTime?             @map("deleted_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([lifecycleStatus, healthStatus])
  @@map("tenant_records")
}

model TenantSettings {
  id              String   @id @default(cuid())
  businessId      String   @unique @map("business_id")
  displayName     String?  @map("display_name")
  supportEmail    String?  @map("support_email")
  billingEmail    String?  @map("billing_email")
  defaultTimezone String   @default("UTC") @map("default_timezone")
  defaultLocale   String   @default("en") @map("default_locale")
  complianceMode  String   @default("standard") @map("compliance_mode")
  customSettings  Json     @default("{}") @map("custom_settings")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model TenantResourceLimit {
  id                   String   @id @default(cuid())
  businessId           String   @unique @map("business_id")
  maxUsers             Int      @default(50) @map("max_users")
  maxBranches          Int      @default(5) @map("max_branches")
  maxStorageBytes      BigInt   @default(10737418240) @map("max_storage_bytes")
  maxApiCallsPerMonth  Int      @default(100000) @map("max_api_calls_per_month")
  maxAiTokensPerMonth  Int      @default(500000) @map("max_ai_tokens_per_month")
  maxDatabaseRows      Int      @default(1000000) @map("max_database_rows")
  maxMarketplaceLicenses Int    @default(10) @map("max_marketplace_licenses")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("tenant_resource_limits")
}

model TenantResourceUsage {
  id                   String   @id @default(cuid())
  businessId           String   @unique @map("business_id")
  activeUsers          Int      @default(0) @map("active_users")
  storageUsedBytes     BigInt   @default(0) @map("storage_used_bytes")
  apiCallsThisMonth    Int      @default(0) @map("api_calls_this_month")
  aiTokensThisMonth    Int      @default(0) @map("ai_tokens_this_month")
  databaseRows         Int      @default(0) @map("database_rows")
  marketplaceLicenses  Int      @default(0) @map("marketplace_licenses")
  fileCount            Int      @default(0) @map("file_count")
  workflowCount        Int      @default(0) @map("workflow_count")
  loginActivityCount   Int      @default(0) @map("login_activity_count")
  moduleUsage          Json     @default("{}") @map("module_usage")
  lastCalculatedAt     DateTime @default(now()) @map("last_calculated_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("tenant_resource_usage")
}

model TenantPolicy {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  policyKey   String   @map("policy_key")
  name        String
  module      String
  description String   @default("") @db.Text
  rules       Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, policyKey])
  @@index([module])
  @@map("tenant_policies")
}

model TenantActivityEvent {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  userId      String?  @map("user_id")
  eventType   String   @map("event_type")
  title       String
  description String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("tenant_activity_events")
}

model TenantImpersonationSession {
  id             String    @id @default(cuid())
  businessId     String    @map("business_id")
  adminUserId    String    @map("admin_user_id")
  targetUserId   String?   @map("target_user_id")
  reason         String    @db.Text
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adminUser User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
  @@map("tenant_impersonation_sessions")
}

model TenantPlatformAuditLog {
  id         String               @id @default(cuid())
  businessId String?              @map("business_id")
  userId     String?              @map("user_id")
  eventType  TenantAuditEventType @map("event_type")
  metadata   Json?
  createdAt  DateTime             @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, eventType, createdAt])
  @@map("tenant_platform_audit_logs")
}
