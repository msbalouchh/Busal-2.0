model RestaurantTable {
  id                String                @id @default(uuid())
  businessId        String                @map("business_id")
  branchId          String                @map("branch_id")
  floorId           String                @map("floor_id")
  tableNumber       String                @map("table_number")
  tableName         String?               @map("table_name")
  capacity          Int
  minimumCapacity   Int                   @default(1) @map("minimum_capacity")
  shape             TableShape            @default(SQUARE)
  positionX         Float                 @default(0) @map("position_x")
  positionY         Float                 @default(0) @map("position_y")
  width             Float                 @default(80)
  height            Float                 @default(80)
  rotation          Float                 @default(0)
  status            RestaurantTableStatus @default(AVAILABLE)
  isReservable      Boolean               @default(true) @map("is_reservable")
  isMergeable       Boolean               @default(true) @map("is_mergeable")
  mergedIntoTableId String?               @map("merged_into_table_id")
