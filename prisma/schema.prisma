  MANUAL
  DOCUSIGN
  ADOBE_SIGN
  HELLOSIGN
}

enum ContractSignatureParty {
  INTERNAL
  CUSTOMER
  WITNESS
}

enum ImplementationProjectStatus {
  PLANNED
  IN_PROGRESS
  LIVE
  HYPERCARE
  COMPLETED
  ON_HOLD
  CLOSED
}

enum ImplementationTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

