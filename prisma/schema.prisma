  createdByStaffId         String?                 @map("created_by_staff_id")
  createdAt                DateTime                @default(now()) @map("created_at")

  product           CommercialProduct      @relation("ProductVersions", fields: [productId], references: [id], onDelete: Cascade)
  currentForProduct CommercialProduct?     @relation("CurrentProductVersion")
  createdByStaff    Staff?                 @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)
  bundleItems       CommercialBundleItem[]
  priceBookEntries  PriceBookEntry[]
  salesOpportunityLinks SalesOpportunityCatalogueLink[]
  quoteLineItems        QuoteLineItem[]
  contractLineItems     ContractLineItem[]
  activatedProducts     ContractActivatedProduct[]

  @@unique([productId, versionNumber])
  @@map("commercial_product_versions")
}

model CommercialBundle {
  id               String                  @id @default(uuid())
  businessId       String                  @map("business_id")
