enum AiToolCategory {
  CRM
  RESTAURANT
  POS
  ORDERS
  RESERVATIONS
  INVENTORY
  REPORTING
  STAFF
  COMMERCIAL
  REVENUE
  AI
  MARKETING
  FINANCE
  ADMINISTRATION
}

enum AiToolStatus {
  ACTIVE
  DISABLED
}

enum AiToolRiskLevel {
  READ_ONLY
  STANDARD
  HIGH_RISK
}

enum AiToolExecutionStatus {
  PENDING
  AWAITING_CONFIRMATION
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  DRY_RUN
}

model AiTool {
  id                   String         @id @default(uuid())
  businessId           String?        @map("business_id")
  toolId               String         @map("tool_id")
  name                 String
  description          String
  module               String
  category             AiToolCategory
  version              String         @default("1.0.0")
  inputSchema          Json           @map("input_schema")
  outputSchema         Json           @map("output_schema")
  requiredPermissions  String[]       @default([]) @map("required_permissions")
  supportedIndustries  String[]       @default([]) @map("supported_industries")
  status               AiToolStatus   @default(ACTIVE)
  riskLevel            AiToolRiskLevel @default(STANDARD) @map("risk_level")
  dryRunSupported      Boolean        @default(false) @map("dry_run_supported")
  confirmationRequired Boolean        @default(false) @map("confirmation_required")
  readOnly             Boolean        @default(false) @map("read_only")
  rollbackCapable      Boolean        @default(false) @map("rollback_capable")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  business   Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  executions AiToolExecution[]

  @@unique([businessId, toolId])
  @@index([category, status])
  @@map("ai_tools")
}

model AiToolExecution {
  id                String                @id @default(uuid())
  businessId        String                @map("business_id")
  branchId          String?               @map("branch_id")
  toolRecordId      String                @map("tool_record_id")
  toolId            String                @map("tool_id")
  agentId           String?               @map("agent_id")
  userId            String?               @map("user_id")
  staffId           String?               @map("staff_id")
  input             Json
  output            Json?
  status            AiToolExecutionStatus @default(PENDING)
  errorDetails      String?               @map("error_details")
  executionTimeMs   Int?                  @map("execution_time_ms")
  tokensUsed        Int?                  @map("tokens_used")
  modelUsed         String?               @map("model_used")
  dryRun            Boolean               @default(false) @map("dry_run")
  confirmed         Boolean               @default(false)
  retryCount        Int                   @default(0) @map("retry_count")
  parentExecutionId String?               @map("parent_execution_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tool            AiTool            @relation(fields: [toolRecordId], references: [id], onDelete: Cascade)
  staff           Staff?            @relation("AiToolExecutionStaff", fields: [staffId], references: [id], onDelete: SetNull)
  parentExecution AiToolExecution?  @relation("AiToolExecutionRetries", fields: [parentExecutionId], references: [id], onDelete: SetNull)
  retries         AiToolExecution[] @relation("AiToolExecutionRetries")

  @@index([businessId, createdAt])
  @@index([toolId, status])
  @@map("ai_tool_executions")
