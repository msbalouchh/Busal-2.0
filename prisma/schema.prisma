model RevenueInvoice {
  id                     String                   @id @default(uuid())
  businessId             String                   @map("business_id")
  invoiceNumber          String                   @map("invoice_number")
  status                 RevenueInvoiceStatus     @default(DRAFT)
  sourceType             RevenueInvoiceSourceType @map("source_type")
  customerId             String?                  @map("customer_id")
  contractId             String?                  @map("contract_id")
  implementationProjectId String?                 @map("implementation_project_id")
  milestoneId            String?                  @map("milestone_id")
  industry               String?
  serviceType            String?                  @map("service_type")
  currency               String                   @default("GBP")
  subtotalPence          Int                      @map("subtotal_pence")
  taxPence               Int                      @default(0) @map("tax_pence")
  totalPence             Int                      @map("total_pence")
  amountPaidPence        Int                      @default(0) @map("amount_paid_pence")
  issuedAt               DateTime?                @map("issued_at")
  dueAt                  DateTime?                @map("due_at")
  paidAt                 DateTime?                @map("paid_at")
  notes                  String?
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  business              Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer              Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contract              Contract?                 @relation(fields: [contractId], references: [id], onDelete: SetNull)
  implementationProject ImplementationProject?    @relation(fields: [implementationProjectId], references: [id], onDelete: SetNull)
  milestone             ImplementationMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  lineItems             RevenueInvoiceLineItem[]
  payments              RevenueInvoicePayment[]
  recognitionEntries    RevenueRecognitionEntry[]
  collectionCases       RevenueCollectionCase[]
  preparedForActivation CustomerActivation?       @relation("ActivationPreparedInvoice")

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status])
  @@index([businessId, sourceType])
  @@map("revenue_invoices")
}

