  pointTransactions          LoyaltyPointTransaction[]
  legacyOrders               LegacyOrder[]
  restaurantOrders           RestaurantOrder[]
  reservations               Reservation[]
  revenueInvoices            RevenueInvoice[]
  aiMemories                 AIMemory[]
  aiConversations            AIConversation[]
  customerAiSessions         CustomerAiSession[]
  aiSalesRecommendations     AISalesRecommendation[]
  aiSupportInsights          AISupportInsight[]
  aiSupportRecommendations   AISupportRecommendation[]
  aiVoiceSessions            AIVoiceSession[]

  @@unique([businessId, phone])
