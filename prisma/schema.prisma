model CommunicationConversation {
  id                String                          @id @default(uuid())
  businessId        String                          @map("business_id")
  branchId          String?                         @map("branch_id")
  customerId        String?                         @map("customer_id")
  contactId         String?                         @map("contact_id")
  assignedStaffId   String?                         @map("assigned_staff_id")
  assignedAiAgentId String?                         @map("assigned_ai_agent_id")
  status            CommunicationConversationStatus @default(OPEN)
  priority          CommunicationPriority           @default(NORMAL)
  tags              String[]                        @default([])
  sourceChannel     CommunicationChannel            @map("source_channel")
  inboxType         CommunicationInboxType          @default(TEAM) @map("inbox_type")
  department        String?
  teamSlug          String?                         @map("team_slug")
  subject           String?
  lastMessageAt     DateTime                        @default(now()) @map("last_message_at")
  closedAt          DateTime?                       @map("closed_at")
  createdAt         DateTime                        @default(now()) @map("created_at")
  updatedAt         DateTime                        @updatedAt @map("updated_at")

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch          Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer        Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact         CommunicationContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedStaff   Staff?                @relation("CommunicationStaffAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedAiAgent AiAgent?              @relation("CommunicationAiAssignee", fields: [assignedAiAgentId], references: [id], onDelete: SetNull)
  messages        CommunicationMessage[]
  activityLogs    CommunicationActivityLog[]
  aiInsights      CommunicationAiInsight[]

  @@index([businessId, status, lastMessageAt])
  @@index([businessId, assignedStaffId, status])
  @@index([businessId, inboxType, status])
  @@index([businessId, sourceChannel])
  @@map("communication_conversations")
}

model CommunicationMessage {
