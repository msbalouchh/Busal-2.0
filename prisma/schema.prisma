/// Tenant membership for multi-tenant RBAC. Owners are provisioned during business setup.
model BusinessMember {
  id          String                 @id @default(uuid())
  businessId  String                 @map("business_id")
  userId      String                 @map("user_id")
  role        BusinessMemberRole     @default(MEMBER)
  status      BusinessMemberStatus   @default(ACTIVE)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  memberRoles MemberRoleAssignment[]
  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId, status])
  @@map("business_members")
}

/// Many-to-many assignment between business members and tenant roles.
model MemberRoleAssignment {
  id               String         @id @default(uuid())
  businessMemberId String         @map("business_member_id")
  roleId           String         @map("role_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  businessMember   BusinessMember @relation(fields: [businessMemberId], references: [id], onDelete: Cascade)
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([businessMemberId, roleId])
  @@index([roleId])
  @@map("business_member_roles")
}

/// Industry module installation for a business tenant.
model BusinessModule {
  id            String               @id @default(uuid())
  businessId    String               @map("business_id")
  moduleKey     String               @map("module_key")
  moduleName    String               @map("module_name")
  status        BusinessModuleStatus @default(INSTALLED)
  isEnabled     Boolean              @default(false) @map("is_enabled")
  installedAt   DateTime?            @map("installed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  configuration ModuleConfiguration?

  @@unique([businessId, moduleKey])
  @@index([businessId, isEnabled])
  @@map("business_modules")
}

/// Per-module JSON configuration scoped to a business installation.
model ModuleConfiguration {
  id               String         @id @default(uuid())
  businessModuleId String         @unique @map("business_module_id")
  config           Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  businessModule   BusinessModule @relation(fields: [businessModuleId], references: [id], onDelete: Cascade)

  @@map("module_configurations")
}

/// Restaurant module configuration scoped to a business.
model RestaurantSettings {
  id                         String   @id @default(uuid())
  businessId                 String   @unique @map("business_id")
  defaultBranchId            String?  @map("default_branch_id")
  businessRegistrationNumber String?  @map("business_registration_number")
  foodLicenseNumber          String?  @map("food_license_number")
  vatNumber                  String?  @map("vat_number")
  defaultCurrency            String?  @default("GBP") @map("default_currency")
  defaultTaxRate             Decimal? @map("default_tax_rate") @db.Decimal(5, 2)
  serviceChargeEnabled       Boolean  @default(false) @map("service_charge_enabled")
  serviceChargePercentage    Decimal? @map("service_charge_percentage") @db.Decimal(5, 2)
  allowTakeaway              Boolean  @default(true) @map("allow_takeaway")
  allowDelivery              Boolean  @default(false) @map("allow_delivery")
  allowDineIn                Boolean  @default(true) @map("allow_dine_in")
  allowReservations          Boolean  @default(true) @map("allow_reservations")
  reservationIntervalMinutes Int      @default(30) @map("reservation_interval_minutes")
  reservationBufferMinutes   Int      @default(15) @map("reservation_buffer_minutes")
  kitchenDisplayEnabled      Boolean  @default(false) @map("kitchen_display_enabled")
  qrOrderingEnabled          Boolean  @default(false) @map("qr_ordering_enabled")
  posEnabled                 Boolean  @default(false) @map("pos_enabled")
  loyaltyEnabled             Boolean  @default(false) @map("loyalty_enabled")
  onlineOrderingEnabled      Boolean  @default(false) @map("online_ordering_enabled")
  settings                   Json     @default("{}")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")
  business                   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultBranch              Branch?  @relation("RestaurantDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)

  @@map("restaurant_settings")
}

/// Restaurant-specific branding for menus, receipts, and guest-facing surfaces.
model RestaurantBranding {
  id             String   @id @default(uuid())
  businessId     String   @unique @map("business_id")
  logo           String?
  coverImage     String?  @map("cover_image")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  receiptFooter  String?  @map("receipt_footer")
  website        String?
  facebook       String?
  instagram      String?
  tiktok         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("restaurant_branding")
}

/// Monotonic sequence for human-readable business codes (e.g. BUS-000001).
model BusinessCodeSequence {
  id        Int @id @default(1)
  lastValue Int @default(0) @map("last_value")

