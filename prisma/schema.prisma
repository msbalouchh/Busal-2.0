  updatedAt        DateTime                @updatedAt @map("updated_at")

  business       Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currentVersion CommercialBundleVersion?  @relation("CurrentBundleVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       CommercialBundleVersion[] @relation("BundleVersions")

  @@unique([businessId, sku])
  @@index([businessId, status])
  @@map("commercial_bundles")
}

model CommercialBundleVersion {
  id               String                 @id @default(uuid())
  bundleId         String                 @map("bundle_id")
  versionNumber    Int                    @map("version_number")
