generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BusinessType {
  RESTAURANT
  CAFE
  BAKERY
  GROCERY
  RETAIL
  SALON
  CLINIC
  HOTEL
  GYM
  PHARMACY
  SERVICES
  OTHER
}

model User {
  id         String     @id
  fullName   String     @map("full_name")
  email      String     @unique
  role       String     @default("owner")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  businesses Business[]
  staffProfile Staff?
  iamIdentities IamIdentity[]
  iamSessions IamSession[]
  iamApiKeys IamApiKey[]
  iamMfaEnrollments IamMfaEnrollment[]
  iamSecurityAuditLogs IamSecurityAuditLog[]
  notificationInboxItems NotificationInboxItem[]
  notificationUserPreferences NotificationUserPreference[]
  notificationAuditLogs NotificationAuditLog[]
  platformFiles PlatformFile[]
  platformFileFolders PlatformFileFolder[]
  platformFileAuditLogs PlatformFileAuditLog[]
  searchQueryLogs SearchQueryLog[]
  searchSuggestions SearchSuggestion[]
  searchAuditLogs SearchAuditLog[]
  configSettingValues ConfigSettingValue[]
  configSettingVersions ConfigSettingVersion[]
  configAuditLogs ConfigAuditLog[]
  featureFlags FeatureFlag[] @relation("FeatureFlagChangedBy")
  featureFlagVersions FeatureFlagVersion[] @relation("FeatureFlagVersionChangedBy")
  featureFlagEvaluationLogs FeatureFlagEvaluationLog[]
  featureFlagAuditLogs FeatureFlagAuditLog[]
  apiRequestLogs ApiRequestLog[]
  apiGatewayAuditLogs ApiGatewayAuditLog[]
  monitoringErrorLogs MonitoringErrorLog[]
  monitoringStructuredLogs MonitoringStructuredLog[]
  monitoringPlatformAuditLogs MonitoringPlatformAuditLog[]
  recoveryJobs RecoveryJob[]
  backupPlatformAuditLogs BackupPlatformAuditLog[]
  localizationPlatformAuditLogs LocalizationPlatformAuditLog[]
  importExportJobs ImportExportJob[]
  importExportPlatformAuditLogs ImportExportPlatformAuditLog[]
  tenantImpersonationSessions TenantImpersonationSession[]
  tenantActivityEvents TenantActivityEvent[]
  tenantPlatformAuditLogs TenantPlatformAuditLog[]

  @@map("users")
}

/// Core business entity. Future modules should reference this model via `businessId`.
model Business {
  id                  String        @id @default(uuid())
  ownerId             String        @map("owner_id")
  ownerName           String?       @map("owner_name")
  businessName        String?       @map("business_name")
  businessType        BusinessType? @map("business_type")
  country             String?
  timezone            String?
  aiName              String?       @map("ai_name")
  aiPersonality       String?       @map("ai_personality")
  businessGoal        String?       @map("business_goal")
  businessDna         Json          @default("{}") @map("business_dna")
  onboardingCompleted Boolean       @default(false) @map("onboarding_completed")
  onboardingStep      Int           @default(1) @map("onboarding_step")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  branches  Branch[]
  hours     BusinessHours[]
  contacts  BusinessContact[]
  staff     Staff[]
  roles     Role[]
  categories Category[]
  menuItems  MenuItem[]
  modifierGroups ModifierGroup[]
  reservations Reservation[]
  tables     Table[]
  qrCodes    QRCode[]
  qrMenuSessions QRMenuSession[]
  carts      Cart[]
  orderSessions OrderSession[]
  orders     Order[]
  kitchenQueue KitchenQueue[]
  payments   Payment[]
  receipts   Receipt[]
  receiptSequences ReceiptSequence[]
  receiptPrintLogs ReceiptPrintLog[]
  receiptAuditLogs ReceiptAuditLog[]
  ingredientCategories IngredientCategory[]
  ingredients Ingredient[]
  recipes Recipe[]
  stockMovements StockMovement[]
  stockAdjustments StockAdjustment[]
  suppliers Supplier[]
  inventoryAuditLogs InventoryAuditLog[]
  orderStockDeductions OrderStockDeduction[]
  customerGroups CustomerGroup[]
  customers Customer[]
  loyaltyPrograms LoyaltyProgram[]
  loyaltyPointTransactions LoyaltyPointTransaction[]
  customerTimelineEvents CustomerTimelineEvent[]
  customerRewardRedemptions CustomerRewardRedemption[]
  rewards Reward[]
  crmAuditLogs CrmAuditLog[]
  reportingAuditLogs ReportingAuditLog[]
  commercialCategories CommercialCategory[]
  commercialProducts CommercialProduct[]
  commercialBundles CommercialBundle[]
  priceBooks PriceBook[]
  commercialAuditLogs CommercialAuditLog[]
  salesPipelines SalesPipeline[]
  salesCompanies SalesCompany[]
  salesContacts SalesContact[]
  salesLeads SalesLead[]
  salesOpportunities SalesOpportunity[]
  salesActivities SalesActivity[]
  salesTasks SalesTask[]
  salesDemos SalesDemo[]
  salesAuditLogs SalesAuditLog[]
  quotes Quote[]
  proposalTemplates ProposalTemplate[]
  proposals Proposal[]
  quoteAuditLogs QuoteAuditLog[]
  contractTypes ContractType[]
  legalClauses LegalClause[]
  contracts Contract[]
  implementationProjects ImplementationProject[]
  contractAuditLogs ContractAuditLog[]
  customerActivations CustomerActivation[]
  projectTemplates ProjectTemplate[]
  implementationAuditLogs ImplementationAuditLog[]
  customerAccountProfiles CustomerAccountProfile[]
  successPlaybooks SuccessPlaybook[]
  customerSuccessAuditLogs CustomerSuccessAuditLog[]
  revenueInvoices RevenueInvoice[]
  revenueExpenses RevenueExpense[]
  revenueForecasts RevenueForecastSnapshot[]
  revopsAuditLogs RevopsAuditLog[]
  aiTools AiTool[]
  aiToolExecutions AiToolExecution[]
  knowledgeCollections KnowledgeCollection[]
  knowledgeSources KnowledgeSource[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeConnectors KnowledgeConnector[]
  knowledgeSearchAudits KnowledgeSearchAudit[]
  automationWorkflows AutomationWorkflow[]
  automationEvents AutomationEvent[]
  automationExecutions AutomationWorkflowExecution[]
  automationAuditLogs AutomationAuditLog[]
  aiAgents AiAgent[]
  aiAgentExecutions AiAgentExecution[]
  aiAgentDelegations AiAgentDelegation[]
  aiAgentMemories AiAgentMemory[]
  aiAgentAuditLogs AiAgentAuditLog[]
  marketplaceInstallations MarketplaceInstallation[]
  marketplaceInstallationHistory MarketplaceInstallationHistory[]
  marketplaceLicenses MarketplaceLicense[]
  marketplaceReviews MarketplaceReview[]
  marketplaceIssueReports MarketplaceIssueReport[]
  marketplaceRevenueRecords MarketplaceRevenueRecord[]
  marketplaceAuditLogs MarketplaceAuditLog[]
  marketplacePublishers MarketplacePublisher[]
  iamIdentities IamIdentity[]
  iamSessions IamSession[]
  iamApiKeys IamApiKey[]
  iamServiceAccounts IamServiceAccount[]
  iamAccessPolicies IamAccessPolicy[]
  iamMfaEnrollments IamMfaEnrollment[]
  iamSecurityAuditLogs IamSecurityAuditLog[]
  notificationTemplates NotificationTemplate[]
  notificationDeliveryRules NotificationDeliveryRule[]
  notificationUserPreferences NotificationUserPreference[]
  notifications Notification[]
  notificationDeliveries NotificationDelivery[]
  notificationInboxItems NotificationInboxItem[]
  notificationAuditLogs NotificationAuditLog[]
  notificationChannelConfigs NotificationChannelConfig[]
  communicationContacts CommunicationContact[]
  communicationConversations CommunicationConversation[]
  communicationMessages CommunicationMessage[]
  communicationMessageAttachments CommunicationMessageAttachment[]
  communicationActivityLogs CommunicationActivityLog[]
  communicationAiInsights CommunicationAiInsight[]
  communicationAuditLogs CommunicationAuditLog[]
  communicationChannelConnectors CommunicationChannelConnector[]
  platformFileStorageConfigs PlatformFileStorageConfig[]
  platformFileFolders PlatformFileFolder[]
  platformFiles PlatformFile[]
  platformFilePermissions PlatformFilePermission[]
  platformFileShareLinks PlatformFileShareLink[]
  platformFileAuditLogs PlatformFileAuditLog[]
  platformFileRetentionPolicies PlatformFileRetentionPolicy[]
  platformFileAiJobs PlatformFileAiJob[]
  searchIndexRecords SearchIndexRecord[]
  searchIndexJobs SearchIndexJob[]
  searchQueryLogs SearchQueryLog[]
  searchResultClicks SearchResultClick[]
  searchSuggestions SearchSuggestion[]
  searchAuditLogs SearchAuditLog[]
  searchAiConfigs SearchAiConfig[]
  configSettingValues ConfigSettingValue[]
  configSettingVersions ConfigSettingVersion[]
  configAuditLogs ConfigAuditLog[]
  featureFlags FeatureFlag[]
  featureFlagTargets FeatureFlagTarget[]
  featureFlagVersions FeatureFlagVersion[]
  featureFlagEvaluationLogs FeatureFlagEvaluationLog[]
  featureFlagAuditLogs FeatureFlagAuditLog[]
  apiRoutes ApiRoute[]
  apiRateLimitPolicies ApiRateLimitPolicy[]
  apiRequestLogs ApiRequestLog[]
  apiWebhookRegistrations ApiWebhookRegistration[]
  apiWebhookDeliveries ApiWebhookDelivery[]
  apiGatewayAuditLogs ApiGatewayAuditLog[]
  monitoringHealthChecks MonitoringHealthCheck[]
  monitoringMetricSnapshots MonitoringMetricSnapshot[]
  monitoringPerformanceLogs MonitoringPerformanceLog[]
  monitoringErrorLogs MonitoringErrorLog[]
  monitoringStructuredLogs MonitoringStructuredLog[]
  monitoringAlerts MonitoringAlert[]
  monitoringRetentionPolicies MonitoringRetentionPolicy[]
  monitoringPlatformAuditLogs MonitoringPlatformAuditLog[]
  backupPolicies BackupPolicy[]
  backupRecords BackupRecord[]
  backupRetentionPolicies BackupRetentionPolicy[]
  disasterRecoveryPlans DisasterRecoveryPlan[]
  recoveryJobs RecoveryJob[]
  backupPlatformAuditLogs BackupPlatformAuditLog[]
  localizationTranslationKeys LocalizationTranslationKey[]
  localizationTranslations LocalizationTranslation[]
  localizationTranslationVersions LocalizationTranslationVersion[]
  localizationScopeSettings LocalizationScopeSetting[]
  localizationPlatformAuditLogs LocalizationPlatformAuditLog[]
  importExportSchemas ImportExportSchema[]
  importExportTemplates ImportExportTemplate[]
  importExportJobs ImportExportJob[]
  importExportJobRecords ImportExportJobRecord[]
  importExportSchedules ImportExportSchedule[]
  importExportPlatformAuditLogs ImportExportPlatformAuditLog[]
  tenantRecord TenantRecord?
  tenantSettings TenantSettings?
  tenantResourceLimit TenantResourceLimit?
  tenantResourceUsage TenantResourceUsage?
  tenantPolicies TenantPolicy[]
  tenantActivityEvents TenantActivityEvent[]
  tenantImpersonationSessions TenantImpersonationSession[]
  tenantPlatformAuditLogs TenantPlatformAuditLog[]

  @@map("businesses")
}

model Branch {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  address    String?
  city       String?
  country    String?
  phone      String?
  isMain     Boolean  @default(false) @map("is_main")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  hours    BusinessHours[]
  staff    Staff[]
  categories Category[]
  menuItems MenuItem[]
  reservations Reservation[]
  tables Table[]
  qrCodes QRCode[]
  qrMenuSessions QRMenuSession[]
  carts Cart[]
  orderSessions OrderSession[]
  orders Order[]
  kitchenQueue KitchenQueue[]
  payments Payment[]
  receipts Receipt[]
  stockMovements StockMovement[]
  stockAdjustments StockAdjustment[]
  knowledgeCollections KnowledgeCollection[]
  communicationConversations CommunicationConversation[]
  platformFileFolders PlatformFileFolder[]
  platformFiles PlatformFile[]

  @@map("branches")
}

model BusinessHours {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  branchId   String?  @map("branch_id")
  dayOfWeek  Int      @map("day_of_week")
  openTime   String?  @map("open_time")
  closeTime  String?  @map("close_time")
  isClosed   Boolean  @default(false) @map("is_closed")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("business_hours")
}

enum BusinessContactType {
  PHONE
  EMAIL
  WEBSITE
  SOCIAL
  OTHER
}

model BusinessContact {
  id         String              @id @default(uuid())
  businessId String              @map("business_id")
  type       BusinessContactType
  label      String?
  value      String
  isPrimary  Boolean             @default(false) @map("is_primary")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_contacts")
}

model Staff {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  branchId   String?  @map("branch_id")
  userId     String?  @unique @map("user_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String?
  phone      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  staffRoles StaffRole[]
  createdReservations Reservation[] @relation("ReservationCreatedBy")
  payments   Payment[]
  receipts   Receipt[]
  receiptPrintLogs ReceiptPrintLog[]
  receiptAuditLogs ReceiptAuditLog[]
  stockMovements StockMovement[]
  stockAdjustments StockAdjustment[]
  inventoryAuditLogs InventoryAuditLog[]
  customerNotes CustomerNote[]
  loyaltyPointTransactions LoyaltyPointTransaction[]
  customerTimelineEvents CustomerTimelineEvent[]
  customerRewardRedemptions CustomerRewardRedemption[]
  crmAuditLogs CrmAuditLog[]
  reportingAuditLogs ReportingAuditLog[]
  commercialProductVersions CommercialProductVersion[]
  commercialBundleVersions CommercialBundleVersion[]
  priceBookVersions PriceBookVersion[]
  commercialAuditLogs CommercialAuditLog[]
  assignedSalesLeads SalesLead[] @relation("SalesLeadAssignee")
  assignedSalesOpportunities SalesOpportunity[] @relation("SalesOpportunityAssignee")
  assignedSalesTasks SalesTask[] @relation("SalesTaskAssignee")
  salesActivities SalesActivity[]
  salesDemos SalesDemo[]
  salesAuditLogs SalesAuditLog[]
  quoteVersionsCreated QuoteVersion[]
  proposalVersionsCreated ProposalVersion[]
  quoteApprovalsRequested QuoteApproval[] @relation("QuoteApprovalRequester")
  quoteApprovalsReviewed QuoteApproval[] @relation("QuoteApprovalReviewer")
  quoteAuditLogs QuoteAuditLog[]
  contractVersionsCreated ContractVersion[]
  contractApprovalsRequested ContractApproval[] @relation("ContractApprovalRequester")
  contractApprovalsReviewed ContractApproval[] @relation("ContractApprovalReviewer")
  contractDocumentsUploaded ContractDocument[]
  assignedImplementationProjects ImplementationProject[] @relation("ImplementationProjectAssignee")
  assignedImplementationTasks ImplementationTask[] @relation("ImplementationTaskAssignee")
  customerSuccessActivations CustomerActivation[] @relation("CustomerSuccessManager")
  contractAuditLogs ContractAuditLog[]
  implementationAuditLogs ImplementationAuditLog[]
  customerSuccessManagerProfiles CustomerAccountProfile[] @relation("CustomerSuccessManagerProfile")
  assignedCustomerSuccessTasks CustomerSuccessTask[] @relation("CustomerSuccessTaskAssignee")
  conductedExecutiveReviews ExecutiveBusinessReview[] @relation("ExecutiveReviewConductor")
  customerSuccessAuditLogs CustomerSuccessAuditLog[]
  recordedRevopsPayments RevenueInvoicePayment[] @relation("RevopsPaymentRecorder")
  revopsAuditLogs RevopsAuditLog[]
  aiToolExecutions AiToolExecution[] @relation("AiToolExecutionStaff")
  assignedCommunicationConversations CommunicationConversation[] @relation("CommunicationStaffAssignee")
  communicationMessagesSent CommunicationMessage[] @relation("CommunicationStaffSender")
  communicationActivityLogs CommunicationActivityLog[]
  communicationAuditLogs CommunicationAuditLog[]
  platformFilesOwned PlatformFile[] @relation("PlatformFileOwnerStaff")
  platformFileVersionsAuthored PlatformFileVersion[] @relation("PlatformFileVersionAuthor")

  @@unique([businessId, email])
  @@map("staff")
}

model Role {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  staffRoles      StaffRole[]

  @@unique([businessId, slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model StaffRole {
  id        String   @id @default(uuid())
  staffId   String   @map("staff_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([staffId, roleId])
  @@map("staff_roles")
}

model Category {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  branchId    String?  @map("branch_id")
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  branchId    String?  @map("branch_id")
  categoryId  String?  @map("category_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true) @map("is_available")
  isFeatured  Boolean  @default(false) @map("is_featured")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  itemModifiers MenuItemModifier[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  recipe        Recipe?
  rewards       Reward[]

  @@map("menu_items")
}

model ModifierGroup {
  id            String   @id @default(uuid())
  businessId    String   @map("business_id")
  name          String
  description   String?
  minSelections Int      @default(0) @map("min_selections")
  maxSelections Int      @default(1) @map("max_selections")
  isRequired    Boolean  @default(false) @map("is_required")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  options       ModifierOption[]
  itemModifiers MenuItemModifier[]

  @@map("modifier_groups")
}

model ModifierOption {
  id              String   @id @default(uuid())
  modifierGroupId String   @map("modifier_group_id")
  name            String
  priceAdjustment Decimal  @default(0) @map("price_adjustment") @db.Decimal(10, 2)
  isDefault       Boolean  @default(false) @map("is_default")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@map("modifier_options")
}

model MenuItemModifier {
  id              String @id @default(uuid())
  menuItemId      String @map("menu_item_id")
  modifierGroupId String @map("modifier_group_id")
  sortOrder       Int    @default(0) @map("sort_order")

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@map("menu_item_modifiers")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  WALK_IN
  PHONE
  WEBSITE
  QR
  ADMIN
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
  OUT_OF_SERVICE
}

model Table {
  id         String      @id @default(uuid())
  businessId String      @map("business_id")
  branchId   String?     @map("branch_id")
  name       String
  section    String?
  capacity   Int
  status     TableStatus @default(AVAILABLE)
  shape      String?
  positionX  Float?      @map("position_x")
  positionY  Float?      @map("position_y")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  qrCodes      QRCode[]
  qrMenuSessions QRMenuSession[]
  orderSessions OrderSession[]
  orders        Order[]

  @@map("tables")
}

model Reservation {
  id                 String            @id @default(uuid())
  businessId         String            @map("business_id")
  branchId           String?           @map("branch_id")
  customerName       String            @map("customer_name")
  customerPhone      String            @map("customer_phone")
  customerEmail      String?           @map("customer_email")
  reservationNumber  String            @unique @map("reservation_number")
  reservationDate    DateTime          @map("reservation_date") @db.Date
  startTime          String            @map("start_time")
  endTime            String            @map("end_time")
  partySize          Int               @map("party_size")
  status             ReservationStatus @default(PENDING)
  notes              String?
  source             ReservationSource @default(ADMIN)
  createdByStaffId   String?           @map("created_by_staff_id")
  tableId            String?           @map("table_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByStaff   Staff?   @relation("ReservationCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  table            Table?   @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@map("reservations")
}

model QRCode {
  id            String    @id @default(uuid())
  businessId    String    @map("business_id")
  branchId      String?   @map("branch_id")
  tableId       String?   @map("table_id")
  code          String    @unique
  slug          String    @unique
  isActive      Boolean   @default(true) @map("is_active")
  scanCount     Int       @default(0) @map("scan_count")
  lastScannedAt DateTime? @map("last_scanned_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  table    Table?          @relation(fields: [tableId], references: [id], onDelete: SetNull)
  sessions QRMenuSession[]

  @@map("qr_codes")
}

model QRMenuSession {
  id           String    @id @default(uuid())
  qrCodeId     String    @map("qr_code_id")
  tableId      String?   @map("table_id")
  businessId   String    @map("business_id")
  branchId     String?   @map("branch_id")
  sessionToken String    @unique @map("session_token")
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  deviceInfo   String?   @map("device_info")
  ipAddress    String?   @map("ip_address")

  qrCode   QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  table    Table?   @relation(fields: [tableId], references: [id], onDelete: SetNull)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  carts    Cart[]
  orderSessions OrderSession[]

  @@map("qr_menu_sessions")
}

enum OrderSessionType {
  DINE_IN
}

enum OrderSessionStatus {
  ACTIVE
  READY
  EXPIRED
  COMPLETED
}

model OrderSession {
  id              String             @id @default(uuid())
  businessId      String             @map("business_id")
  branchId        String?            @map("branch_id")
  cartId          String             @map("cart_id")
  qrMenuSessionId String             @map("qr_menu_session_id")
  sessionType     OrderSessionType   @default(DINE_IN) @map("session_type")
  tableId         String?            @map("table_id")
  customerName    String?            @map("customer_name")
