model PlatformFileStorageConfig {
  id         String              @id @default(uuid())
  businessId String?             @map("business_id")
  provider   FileStorageProvider @default(LOCAL)
  name       String
  config     Json?
  isEnabled  Boolean             @default(true) @map("is_enabled")
  isDefault  Boolean             @default(false) @map("is_default")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
  @@index([businessId, isEnabled])
  @@map("platform_file_storage_configs")
}

model PlatformFileFolder {
  id           String         @id @default(uuid())
  businessId   String         @map("business_id")
  branchId     String?        @map("branch_id")
  parentId     String?        @map("parent_id")
  folderType   FileFolderType @map("folder_type")
  name         String
  slug         String
  path         String
  department   String?
  projectId    String?        @map("project_id")
  customerId   String?        @map("customer_id")
  ownerUserId  String?        @map("owner_user_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent   PlatformFileFolder? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children PlatformFileFolder[] @relation("FolderHierarchy")
  ownerUser User?             @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  files    PlatformFile[]

  @@unique([businessId, path])
  @@index([businessId, folderType])
  @@index([parentId])
  @@map("platform_file_folders")
}

model PlatformFile {
  id                   String              @id @default(uuid())
  businessId           String              @map("business_id")
  branchId             String?             @map("branch_id")
  folderId             String?             @map("folder_id")
  ownerUserId          String?             @map("owner_user_id")
  ownerStaffId         String?             @map("owner_staff_id")
  module               String
  entityType           String?             @map("entity_type")
  entityId             String?             @map("entity_id")
  originalName         String              @map("original_name")
  storedName           String              @map("stored_name")
  mimeType             String              @map("mime_type")
  extension            String
  sizeBytes            Int                 @map("size_bytes")
  checksum             String
  currentVersionNumber Int                 @default(1) @map("current_version_number")
  status               FileStatus          @default(ACTIVE)
  tags                 String[]            @default([])
  metadata             Json?
  storageProvider      FileStorageProvider @default(LOCAL) @map("storage_provider")
  storageKey           String              @map("storage_key")
  previewType          FilePreviewType?    @map("preview_type")
  deletedAt            DateTime?           @map("deleted_at")
  archivedAt           DateTime?           @map("archived_at")
  legalHoldAt          DateTime?           @map("legal_hold_at")
  retentionExpiresAt   DateTime?           @map("retention_expires_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  business    Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  folder      PlatformFileFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  ownerUser   User?                    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerStaff  Staff?                   @relation("PlatformFileOwnerStaff", fields: [ownerStaffId], references: [id], onDelete: SetNull)
  versions    PlatformFileVersion[]
  permissions PlatformFilePermission[]
  shareLinks  PlatformFileShareLink[]
  aiJobs      PlatformFileAiJob[]

  @@index([businessId, module, status])
  @@index([businessId, entityType, entityId])
  @@index([folderId])
  @@index([checksum])
  @@map("platform_files")
}

model PlatformFileVersion {
  id            String   @id @default(uuid())
  fileId        String   @map("file_id")
  businessId    String   @map("business_id")
  versionNumber Int      @map("version_number")
  storedName    String   @map("stored_name")
  storageKey    String   @map("storage_key")
  sizeBytes     Int      @map("size_bytes")
  checksum      String
  authorUserId  String?  @map("author_user_id")
  authorStaffId String?  @map("author_staff_id")
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at")

  file        PlatformFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  authorStaff Staff?       @relation("PlatformFileVersionAuthor", fields: [authorStaffId], references: [id], onDelete: SetNull)

  @@unique([fileId, versionNumber])
  @@index([fileId, versionNumber])
  @@map("platform_file_versions")
}

model PlatformFilePermission {
  id         String              @id @default(uuid())
  fileId     String              @map("file_id")
  businessId String              @map("business_id")
  scope      FilePermissionScope
  scopeRef   String?             @map("scope_ref")
  level      FilePermissionLevel
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  file     PlatformFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([fileId, scope, level])
  @@index([businessId, scopeRef])
  @@map("platform_file_permissions")
}

model PlatformFileShareLink {
  id              String            @id @default(uuid())
  fileId          String            @map("file_id")
  businessId      String            @map("business_id")
  linkType        FileShareLinkType @map("link_type")
  token           String            @unique
  passwordHash    String?           @map("password_hash")
  expiresAt       DateTime?         @map("expires_at")
  downloadLimit   Int?              @map("download_limit")
  downloadCount   Int               @default(0) @map("download_count")
  createdByUserId String?           @map("created_by_user_id")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")

  file     PlatformFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([fileId, isActive])
  @@index([businessId, linkType])
  @@map("platform_file_share_links")
}

model PlatformFileAuditLog {
  id         String             @id @default(uuid())
  businessId String             @map("business_id")
  fileId     String?            @map("file_id")
  eventType  FileAuditEventType @map("event_type")
  userId     String?            @map("user_id")
  staffId    String?            @map("staff_id")
  metadata   Json?
  createdAt  DateTime           @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([fileId, eventType])
  @@map("platform_file_audit_logs")
}

model PlatformFileRetentionPolicy {
