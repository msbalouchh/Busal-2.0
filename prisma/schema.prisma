  preparedProposal Proposal? @relation("OpportunityPreparedProposal", fields: [preparedProposalId], references: [id], onDelete: SetNull)
  preparedContract Contract? @relation("OpportunityPreparedContract", fields: [preparedContractId], references: [id], onDelete: SetNull)
  contracts       Contract[]
