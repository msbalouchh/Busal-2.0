model Contract {
  id               String         @id @default(uuid())
  businessId       String         @map("business_id")
  contractTypeId   String         @map("contract_type_id")
  opportunityId    String         @map("opportunity_id")
  quoteId          String         @map("quote_id")
  proposalId       String         @map("proposal_id")
  contractNumber   String         @map("contract_number")
  status           ContractStatus @default(DRAFT)
  currency         String         @default("GBP")
  currentVersionId String?        @unique @map("current_version_id")
  startDate        DateTime?      @map("start_date")
  endDate          DateTime?      @map("end_date")
  renewalDate      DateTime?      @map("renewal_date")
  deletedAt        DateTime?      @map("deleted_at")
  archivedAt       DateTime?      @map("archived_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  business         Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contractType     ContractType          @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  opportunity      SalesOpportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  quote            Quote                 @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  proposal         Proposal              @relation("ContractSourceProposal", fields: [proposalId], references: [id], onDelete: Restrict)
  currentVersion   ContractVersion?      @relation("CurrentContractVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         ContractVersion[]     @relation("ContractVersions")
  approvals        ContractApproval[]
  signatures       ContractSignature[]
  documents        ContractDocument[]
  renewals         ContractRenewal[]
  activation       CustomerActivation?
  implementationProject ImplementationProject?
  preparedForOpportunity SalesOpportunity? @relation("OpportunityPreparedContract")
  preparedForProposal Proposal?          @relation("ProposalPreparedContract")
  accountProfile CustomerAccountProfile?
  customerRenewalRecords CustomerRenewalRecord[]
  revenueInvoices RevenueInvoice[]

  @@unique([businessId, contractNumber])
  @@index([businessId, status])
  @@map("contracts")
}

