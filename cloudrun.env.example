# Copy these names and values into Cloud Run / Secret Manager. Never commit a
# populated version of this file.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://YOUR_CLOUD_RUN_OR_CUSTOM_DOMAIN
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
DATABASE_URL=YOUR_POOLED_POSTGRES_URL
DIRECT_URL=YOUR_DIRECT_POSTGRES_URL
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
CRON_SECRET=GENERATE_A_LONG_RANDOM_VALUE

# Include the existing production values from .env.example and your current
# production environment as applicable: Stripe price/product IDs, Supabase,
# OAuth, email, storage, and any AI/provider credentials BUSAL needs.
