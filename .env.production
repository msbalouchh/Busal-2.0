# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database (Supabase PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# Application — canonical production URL (www)
NEXT_PUBLIC_APP_URL=https://www.getbusal.com
NODE_ENV=production

# Production deployment checklist (set in Vercel project settings, never commit secrets):
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - DATABASE_URL (Supabase pooler, port 6543)
# - DIRECT_URL (Supabase direct, port 5432)
#
# Supabase Auth redirect URLs (Dashboard > Authentication > URL Configuration):
# - Site URL: https://www.getbusal.com
# - Redirect URLs: https://www.getbusal.com/auth/callback
#
# DNS (www.getbusal.com):
# - CNAME www → cname.vercel-dns.com
# - A apex getbusal.com → 76.76.21.21 (Vercel) OR redirect via registrar
